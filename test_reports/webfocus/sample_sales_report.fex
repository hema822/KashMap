-* Sample WebFOCUS Regional Sales Report
DEFINE FILE GGSALES
  PROFIT/D12.2 = DOLLARS - BUDDOLLARS;
  PROFIT_MARGIN/D12.2% = (PROFIT / DOLLARS) * 100;
  GROWTH_RATIO/D12.2 = (DOLLARS - BUDDOLLARS) / BUDDOLLARS;
END
TABLE FILE GGSALES
  SUM DOLLARS AS 'Revenue'
      UNITS AS 'Units Sold'
      PROFIT AS 'Gross Profit'
      COMPUTE BONUS/D12.2 = IF PROFIT GT 50000 THEN PROFIT * 0.10 ELSE 0; AS 'Sales Bonus'
  BY REGION
  BY CATEGORY
  BY PRODUCT
  WHERE REGION EQ 'Midwest' OR 'Northeast';
ON TABLE PCHOLD FORMAT HTML
END
