    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>	SELECT DISTINCT
    YEAR(CAST('01 ' + [Posting Period] AS DATE)) AS YearValue
FROM pbirpt.vw_mbewithgm
ORDER BY YearValue DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="YearValue">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>YearValue</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>
SELECT DISTINCT 
    LEFT([Posting Period], CHARINDEX(' ', [Posting Period]) - 1) AS MonthName,
    CASE LEFT([Posting Period], CHARINDEX(' ', [Posting Period]) - 1)
        WHEN 'Jan' THEN 1
        WHEN 'Feb' THEN 2
        WHEN 'Mar' THEN 3
        WHEN 'Apr' THEN 4
        WHEN 'May' THEN 5
        WHEN 'Jun' THEN 6
        WHEN 'Jul' THEN 7
        WHEN 'Aug' THEN 8
        WHEN 'Sep' THEN 9
        WHEN 'Oct' THEN 10
        WHEN 'Nov' THEN 11
        WHEN 'Dec' THEN 12
    END AS MonthOrder
FROM pbirpt.vw_mbewithgm
ORDER BY MonthOrder</CommandText>
      </Query>
      <Fields>
        <Field Name="MonthName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>MonthName</DataField>
        </Field>
        <Field Name="MonthOrder">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>MonthOrder</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
