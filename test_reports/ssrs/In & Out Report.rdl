        <CommandText>SELECT
  vw_InAndOutReport.PO_Date
  ,vw_InAndOutReport.CreatedDate
  ,vw_InAndOutReport.OnTheHour_Sort
  ,vw_InAndOutReport.HighlightLowSalesQty
  ,vw_InAndOutReport.OnTheHour_RunHour
  ,vw_InAndOutReport.Ship_City_State_Zip
