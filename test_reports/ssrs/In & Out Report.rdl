  ,vw_InAndOutReport.Cust_Item_Number
  ,vw_InAndOutReport.[Sales Order Status]
  ,vw_InAndOutReport.RunHour
  ,vw_InAndOutReport.BillingAddress_Addressee
  ,vw_InAndOutReport.BillingAddress_Addr1
  ,vw_InAndOutReport.Bill_City_State_Zip
  ,vw_InAndOutReport.PO_Number
  ,vw_InAndOutReport.SourceFile
  ,vw_InAndOutReport.BT_Duns_Number
  ,vw_InAndOutReport.AccountNumber
  ,vw_InAndOutReport.NS_OrderNumber
  ,vw_InAndOutReport.[Assigned Customer Service Rep]
  ,vw_InAndOutReport.ShippingAddress_Addressee
