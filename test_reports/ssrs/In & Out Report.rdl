      <Filters>
        <Filter>
          <FilterExpression>=Fields!CreatedDate.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue>=Parameters!DateParm.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Format(Fields!OnTheHour_RunHour.Value, "h:mm tt")</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue>=Parameters!HourParm.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="DateDataSet">
      <Query>
        <DataSourceName>InOut</DataSourceName>
        <CommandText>SELECT DISTINCT 
  CreatedDate AS DateValue,
  CONVERT(varchar(10), CreatedDate, 101) AS DateLabel
FROM [pbirpt].[vw_InAndOutReport]
WHERE CreatedDate IS NOT NULL
ORDER BY DateValue DESC
</CommandText>
      </Query>
      <Fields>
        <Field Name="DateValue">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>DateValue</DataField>
        </Field>
        <Field Name="DateLabel">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>DateLabel</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="HourDataSet">
      <Query>
        <DataSourceName>InOut</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DateParm">
            <Value>=Parameters!DateParm.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT 
  FORMAT(OnTheHour_RunHour, 'h:mm tt') AS DisplayHour,
  OnTheHour_RunHour
FROM [pbirpt].[vw_InAndOutReport]
WHERE CreatedDate = @DateParm
  AND OnTheHour_RunHour IS NOT NULL
ORDER BY OnTheHour_RunHour
</CommandText>
      </Query>
      <Fields>
        <Field Name="DisplayHour">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>DisplayHour</DataField>
        </Field>
        <Field Name="OnTheHour_RunHour">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>OnTheHour_RunHour</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
