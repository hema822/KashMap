  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Inventory</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP(
				'Items_Inventory_ByLocation'[Warehouse],
				'vw_itemDetails'[ITEM NUMBER],
				'vw_itemDetails'[Description],
				'Items_Inventory_ByLocation'[Lot],
				'Items_Inventory_ByLocation'[PRINT_FLAG],
				'Items_Inventory_ByLocation'[Order],
				'Items_Inventory_ByLocation'[Today],
				'Items_Inventory_ByLocation'[ReportType]
			), "IsGrandTotalRowTotal"
		),
		"SumNetSuite", CALCULATE(SUM('Items_Inventory_ByLocation'[NetSuite])),
		"SumDSI", CALCULATE(SUM('Items_Inventory_ByLocation'[DSI])),
		"SumDifference", CALCULATE(SUM('Items_Inventory_ByLocation'[Difference]))
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'Items_Inventory_ByLocation'[Warehouse],
	'vw_itemDetails'[ITEM NUMBER],
	'vw_itemDetails'[Description],
	'Items_Inventory_ByLocation'[Lot],
	'Items_Inventory_ByLocation'[PRINT_FLAG],
	'Items_Inventory_ByLocation'[Order],
	'Items_Inventory_ByLocation'[Today],
	'Items_Inventory_ByLocation'[ReportType]</CommandText>
      </Query>
