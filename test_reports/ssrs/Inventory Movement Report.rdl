  <DataSources>
    <DataSource Name="Inventory">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQLAZURE</DataProvider>
        <ConnectString>Data Source=gbl-eastus2-synapse-01-prod-synapse.sql.azuresynapse.net;Initial Catalog=SwisherReporting;Encrypt=True;Authentication=ActiveDirectoryInteractive
</ConnectString>
