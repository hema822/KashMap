  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Inventory</DataSourceName>
        <CommandText>WITH FilteredItems AS (
    SELECT 
        ITEM,
        ITEM AS ITEM_NUMBER,
        BRAND,
        SHAPECUT,
        BLEND,
        [ITEM DESCRIPTION] AS ITEM_DESCRIPTION,
        SELLABLE
    FROM pbirpt.vw_items
    WHERE ITEM IN (
        '010210','010300','010301','010302','010303','010304','010305','010306','010307','010310','010311',
        '010370','010371','010372','010374','010375','010376','010413','010414','020100','020110','020130',
        '020140','020160','030501','030502','030520','030521','030522','20032','20034','20095','20121',
        '20259','20273','20275','20278','20284','20287','20320','20327','20386','20387','20388','20389',
        '20535','20537','20538','20539','20559','20565','20567','20588','20589','20591','20592','20593',
        '20594','20604','20739','20742','20746','20747','20748','20749','20750','20760','20762','20768',
        '20946','20954','20972','20974','20975','20983','22012','22051','22053','22056','22057','22059',
        '22068','22070','22077','22078','22079','22080','22081','22086','22090','22092','22116','22118',
        '22330','22334','22520','22521','22522','22571','22572','22573','22574','22641','22643','22650',
        '22673','22674','22678','22682','22683','22686','22693','22733','22734','22735','22740','22742',
        '22749','22764','22765','22768','22771','22772','22880','22881','22883','22884','22885','22886',
        '22899','22900','22920','22924','22925','22927','22930','22933','22937','22950','22952','22955',
        '22956','22958','22960','22962','22963','22964','22970','22982','22983','22985','22986','22987',
        '22988','22989','22991','22992','23014','23015','23016','23026','23501','23522','23533','23542',
        '23543','23547','23549','23568','23569','23571','23574','23580','23581','23584','23590','23591',
        '23594','23595','23604','23605','23635','23642','23643','23670','23671','23672','23673','23674',
        '23675','23677','23687','23688','23689','23690','23691','23701','23712','23715','23716','23717',
        '23719','23720','23721','23722','23723','23728','23729','23730','23734','23765','23766','23955',
        '24349','24350','24352','24353','24466','24593','24652','24716','24753','25430','25900','25901',
        '25902','25903','25904','25905','25906','25909','25910','25930','25931','25932','25934','25950',
        '25951','25952','25953','25954','25955','25956','25960','25961','25962','25963','25964','25965',
        '25966','26108','26109','26111','26112','26113','26115','26116','26117','26118','26120','26135',
        '26137','26312','26313','26317','26319','26320','26321','26322','26323','26330','26331','26412',
        '26413','26415','26417','26418','26419','26421','26422','26423','26910','26911','26913','27420',
        '27421','27430','27431','27520','27521','27522','27523','27524','27525','27528','27587','27588',
        '27592','27594','27900','27901','27902','27903','27910','27911','27913','28130','28131','28132',
        '28133','28134','28140','28141','28142','28143','28144','48340','48341','48342','48343','48344',
        '24552','24553','27502','24554','24557','24562','24560','24556','24559','24563','24561','24567',
'26116','27501','24565','24555','26951','22553','24564'
    )
),
Last3Months AS (
    SELECT 
        ITEM_NUMBER AS ITEM, 
        SUM(QTY_SHIP) AS Total_Shipped_Eaches
    FROM pbirpt.vw_ShipOrdCasInv
    WHERE TRAN_DATE &gt;= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()) - 3, 1)
      AND TRAN_DATE &lt; DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)
      AND TRANSACTION_TYPE = 'CustInvc'
      AND ORDER_TYPE IN (2, 3, 6, 10)
    GROUP BY ITEM_NUMBER
),
AvgShip AS (
    SELECT ITEM, CAST(Total_Shipped_Eaches AS FLOAT) / 63 AS Daily_Avg_Shipment
    FROM Last3Months
),
OpenOrders AS (
    SELECT ITEM_NUMBER AS ITEM, SUM(OpenOrders) AS Open_Orders
    FROM pbirpt.vw_OpenOrdersByItem
    GROUP BY ITEM_NUMBER
),
Inventory AS (
    SELECT 
        i.[ITEM NUMBER] AS ITEM,
        SUM(CASE WHEN i.STOCK_LOCATION = 'Jax TP Shipping' THEN i.QUANTITY_ONHAND ELSE 0 END) AS JAX_TP,
        SUM(CASE WHEN i.STOCK_LOCATION IN ('Grimes', 'TDI - Bulls Bay') THEN i.QUANTITY_ONHAND ELSE 0 END) AS GRIMES,
        SUM(CASE WHEN i.STOCK_LOCATION = 'FTT' THEN i.QUANTITY_ONHAND ELSE 0 END) AS FTT,
        SUM(CASE WHEN i.STOCK_LOCATION = 'TDI Pritchard' THEN i.QUANTITY_ONHAND ELSE 0 END) AS TDI_PD,
        SUM(CASE WHEN i.STOCK_LOCATION = 'Desert Empire Swisher' THEN i.QUANTITY_ONHAND ELSE 0 END) AS DESERT,
        SUM(i.QUANTITY_ONHAND) AS TOTAL_INVENTORY
    FROM pbirpt.vw_ItemsInventory i
    INNER JOIN FilteredItems f ON i.[ITEM NUMBER] = f.ITEM
    GROUP BY i.[ITEM NUMBER]
),
MTD_YTD_Ship AS (
    SELECT 
        ITEM_NUMBER AS ITEM,
        MAX(DATETIMESTAMPED) AS DATETIMESTAMPED,
        SUM(CASE WHEN TRAN_DATE &gt;= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1) 
                  AND TRAN_DATE &lt;= GETDATE() THEN QTY_SHIP ELSE 0 END) AS MTD_JAX,
        SUM(CASE WHEN TRAN_DATE &gt;= DATEFROMPARTS(YEAR(GETDATE()), 1, 1) 
                  AND TRAN_DATE &lt;= GETDATE() THEN QTY_SHIP ELSE 0 END) AS YTD_JAX
    FROM pbirpt.vw_ShipOrdCasInv
    WHERE ORDER_TYPE IN (2, 3, 6, 10) AND TRANSACTION_TYPE = 'CustInvc'
    GROUP BY ITEM_NUMBER
),
InRoute AS (
    SELECT NS_ITEM AS ITEM, SUM(CAST(CIGARS AS BIGINT)) AS IN_ROUTE
    FROM pbirpt.vw_SDI_Shipments_History
    WHERE [Date] &gt;= '2019-10-01'
      AND (Status IS NULL OR LTRIM(RTRIM(Status)) IN ('', ' ', 'Pending Receipt'))
    GROUP BY NS_ITEM
),
YTDSDI AS (
    SELECT NS_ITEM AS ITEM, SUM(CAST(CIGARS AS BIGINT)) AS YTD_SDI
    FROM pbirpt.vw_SDI_Shipments_History
    WHERE [Date] &gt;= DATEFROMPARTS(YEAR(GETDATE()), 1, 1) AND [Date] &lt;= GETDATE()
    GROUP BY NS_ITEM
)
SELECT
    f.*,
    inv.JAX_TP,
    inv.GRIMES,
    inv.FTT,
    inv.TDI_PD,
    inv.DESERT,
    inv.TOTAL_INVENTORY,
    COALESCE(o.Open_Orders, 0) AS OPEN_ORDERS,
    COALESCE(s.Daily_Avg_Shipment, 0) AS DAILY_AVG,
    inv.TOTAL_INVENTORY + COALESCE(r.IN_ROUTE, 0) AS INV_INROUTE,
    inv.TOTAL_INVENTORY + COALESCE(r.IN_ROUTE, 0) - COALESCE(o.Open_Orders, 0) AS INV_INROUTE_ORDERS,
    inv.TOTAL_INVENTORY / NULLIF(s.Daily_Avg_Shipment, 0) AS DOH,
    (inv.TOTAL_INVENTORY - COALESCE(o.Open_Orders, 0)) / NULLIF(s.Daily_Avg_Shipment, 0) AS DOH_INROUTE_ORDERS,
    COALESCE(m.MTD_JAX, 0) AS MTD_JAX,
    COALESCE(m.YTD_JAX, 0) AS YTD_JAX,
    COALESCE(r.IN_ROUTE, 0) AS IN_ROUTE,
    COALESCE(y.YTD_SDI, 0) AS YTD_SDI,
    m.DATETIMESTAMPED
FROM FilteredItems f
LEFT JOIN Inventory inv ON f.ITEM = inv.ITEM
LEFT JOIN AvgShip s ON f.ITEM = s.ITEM
LEFT JOIN OpenOrders o ON f.ITEM = o.ITEM
LEFT JOIN MTD_YTD_Ship m ON f.ITEM = m.ITEM
LEFT JOIN InRoute r ON f.ITEM = r.ITEM
LEFT JOIN YTDSDI y ON f.ITEM = y.ITEM</CommandText>
      </Query>
      <Fields>
        <Field Name="ITEM">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ITEM</DataField>
        </Field>
        <Field Name="ITEM_NUMBER">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ITEM_NUMBER</DataField>
        </Field>
        <Field Name="BRAND">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>BRAND</DataField>
        </Field>
        <Field Name="SHAPECUT">
