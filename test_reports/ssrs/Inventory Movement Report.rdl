        <Field Name="FTT">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>FTT</DataField>
        </Field>
        <Field Name="TDI_PD">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TDI_PD</DataField>
        </Field>
        <Field Name="DESERT">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>DESERT</DataField>
        </Field>
        <Field Name="TOTAL_INVENTORY">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TOTAL_INVENTORY</DataField>
        </Field>
        <Field Name="OPEN_ORDERS">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>OPEN_ORDERS</DataField>
        </Field>
        <Field Name="DAILY_AVG">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>DAILY_AVG</DataField>
        </Field>
        <Field Name="INV_INROUTE">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>INV_INROUTE</DataField>
        </Field>
        <Field Name="INV_INROUTE_ORDERS">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>INV_INROUTE_ORDERS</DataField>
        </Field>
        <Field Name="DOH">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>DOH</DataField>
        </Field>
        <Field Name="DOH_INROUTE_ORDERS">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>DOH_INROUTE_ORDERS</DataField>
        </Field>
        <Field Name="MTD_JAX">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>MTD_JAX</DataField>
        </Field>
        <Field Name="YTD_JAX">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>YTD_JAX</DataField>
        </Field>
        <Field Name="IN_ROUTE">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>IN_ROUTE</DataField>
        </Field>
        <Field Name="YTD_SDI">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>YTD_SDI</DataField>
        </Field>
        <Field Name="DATETIMESTAMPED">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>DATETIMESTAMPED</DataField>
        </Field>
      </Fields>
    </DataSet>
