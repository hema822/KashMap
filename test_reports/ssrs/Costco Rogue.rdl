  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>CostcoCigar</DataSourceName>
        <CommandText>SELECT  
[ACCOUNT_NUMBER]
      ,[COMPANY_NAME]
      ,[CUST_NAME]
      ,[CITY]
      ,[STATE]
      ,[DIVISION_PARENT]
      ,[Account_Company_Key]
      ,[Fiscal_Year_Start_Month]
      ,[Last_Complete_Month_Name]
      ,[DateTimeStamped]
      ,[Invc_Units_TY]
      ,[Cred_Units_TY]
      ,[Invc_Dollars_TY]
      ,[Cred_Dollars_TY]
      ,[Invc_Units_LY]
      ,[Cred_Units_LY]
      ,[Invc_Dollars_LY]
      ,[Cred_Dollars_LY]
      ,[Total_Units_TY]
      ,[Total_Units_LY]
      ,[Total_Dollars_TY]
      ,[Total_Dollars_LY]
      ,[Units_Diff_TY_LY]
      ,[Dollars_Diff_TY_LY]
      ,[Invc_Units_Diff_TY]
      ,[Invc_Units_Diff_LY]
      ,[Invc_Dollars_Diff_TY]
      ,[Invc_Dollars_Diff_LY]
FROM [pbirpt].[vw_CostcoSalesSummary]
WHERE DIVISION_PARENT = 'Rogue'</CommandText>
      </Query>
